@model List<Project>
@{
    ViewData["Title"] = "پروژه‌های معماری و اجرایی";
    ViewData["MetaDescription"] = "آرشیو پروژه‌های طراحی، بازسازی و اجرای ساختمان مجموعه ساخت خانه.";
    ViewData["VisitType"] = "static";
    ViewData["VisitParam"] = "projects";
}

@await Html.PartialAsync("_PageHeroPartialView", new PageHeroViewModel
{
    Eyebrow = "آرشیو پروژه‌ها",
    Title = "نمونه‌هایی از",
    AccentTitle = "طراحی و اجرای واقعی",
    Description = "پروژه‌هایی با مقیاس، نیاز و زبان طراحی متفاوت؛ اما با یک استاندارد مشترک در جزئیات و کیفیت اجرا.",
    CurrentPageTitle = "پروژه‌ها"
})

<div class="content-wrapper">
    <section class="content-lines-wrapper" aria-hidden="true"><div class="content-lines-inner"><div class="content-lines"></div></div></section>
    <section class="sk-section projects section-padding">
        <div class="container">
            <div class="sk-section-heading" data-sk-reveal="up">
                <div class="sk-section-heading__copy">
                    <p class="sk-section-heading__eyebrow">پروژه‌های منتخب</p>
                    <h2 class="sk-section-heading__title">هر پروژه، پاسخی به یک <span>نیاز مشخص</span></h2>
                </div>
            </div>

            @if (Model.Count > 0)
            {
                <div class="sk-card-grid sk-card-grid--two">
                    @for (var i = 0; i < Model.Count; i++)
                    {
                        var project = Model[i];
                        <article class="item sk-project-card" data-sk-reveal="up" data-sk-delay-index="@(i % 4)">
                            <div class="position-re o-hidden">
                                <span class="sk-project-status @ProjectPresentation.StatusCss(project.Status)">@ProjectPresentation.StatusTitle(project.Status)</span>
                                <a href="/Projects/@project.Endpoint_Path">
                                    <img src="@WebAssetUrl.Normalize(project.CoverImageUrl)"
                                         alt="@(project.CoverImageAlt ?? project.Title)"
                                         width="1200"
                                         height="800"
                                         loading="lazy"
                                         decoding="async" />
                                </a>
                            </div>
                            <div class="con">
                                <p class="sk-project-card__location">
                                    @if (project.Category is not null)
                                    {
                                        <a href="/Projects/Category/@project.Category.Slug">@project.Category.Title</a><span aria-hidden="true"> · </span>
                                    }
                                    <a href="/Projects/@project.Endpoint_Path">@(string.IsNullOrWhiteSpace(project.Location) ? "پروژه ساخت خانه" : project.Location)</a>
                                </p>
                                <h2><a href="/Projects/@project.Endpoint_Path">@project.Title</a></h2>
                                <a class="sk-project-card__arrow" href="/Projects/@project.Endpoint_Path" aria-label="مشاهده پروژه @project.Title">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                </a>
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="sk-empty-state"><h2>پروژه‌ای برای نمایش ثبت نشده است</h2></div>
            }
        </div>
    </section>
</div>
