@model List<BlogPost>
@{
    ViewData["Title"] = "مقالات معماری و ساخت‌وساز";
    ViewData["MetaDescription"] = "مقالات تخصصی ساخت خانه درباره معماری، طراحی داخلی، متریال، بازسازی و نکات اجرایی ساختمان.";
    ViewData["VisitType"] = "static";
    ViewData["VisitParam"] = "blog";

    string PlainText(string? html, int maxLength = 170)
    {
        var value = System.Net.WebUtility.HtmlDecode(System.Text.RegularExpressions.Regex.Replace(html ?? string.Empty, "<.*?>", string.Empty));
        value = System.Text.RegularExpressions.Regex.Replace(value, @"\s+", " ").Trim();
        return value.Length <= maxLength ? value : $"{value[..(maxLength - 3)].TrimEnd()}...";
    }
}

@await Html.PartialAsync("_PageHeroPartialView", new PageHeroViewModel
{
    Eyebrow = "دانش و تجربه",
    Title = "مقالات تخصصی برای",
    AccentTitle = "تصمیم‌گیری بهتر",
    Description = "بررسی متریال‌ها، روش‌های اجرا، جزئیات فنی و موضوعاتی که در طراحی و ساخت یک پروژه اهمیت دارند.",
    CurrentPageTitle = "بلاگ"
})

<div class="content-wrapper">
    <section class="content-lines-wrapper" aria-hidden="true"><div class="content-lines-inner"><div class="content-lines"></div></div></section>
    <section class="sk-section section-padding">
        <div class="container">
            <div class="sk-section-heading" data-sk-reveal="up">
                <div class="sk-section-heading__copy">
                    <p class="sk-section-heading__eyebrow">آخرین مطالب</p>
                    <h2 class="sk-section-heading__title">دانش اجرایی، بدون <span>توضیحات سطحی</span></h2>
                </div>
            </div>

            @if (Model.Count > 0)
            {
                <div class="sk-card-grid">
                    @for (var i = 0; i < Model.Count; i++)
                    {
                        var post = Model[i];
                        <article class="sk-content-card" data-sk-reveal="up" data-sk-delay-index="@(i % 5)">
                            <a class="sk-content-card__media" href="/Blog/@post.EndpointPath">
                                <img class="sk-content-card__image"
                                     src="@WebAssetUrl.Normalize(post.ImageUrl)"
                                     alt="@(post.ImageAlt ?? post.Title)"
                                     width="1200"
                                     height="800"
                                     loading="lazy"
                                     decoding="async" />
                            </a>
                            <div class="sk-content-card__body">
                                <p class="sk-content-card__meta">
                                    <a href="/Blog/Category/@post.Category.Slug">@post.Category.Title</a>
                                    <span aria-hidden="true">—</span>
                                    <time datetime="@post.CreationDate.ToString("yyyy-MM-dd")">@IranDateTime.ToPersianDate(post.CreationDate)</time>
                                </p>
                                <h2 class="sk-content-card__title"><a href="/Blog/@post.EndpointPath">@post.Title</a></h2>
                                <p class="sk-content-card__excerpt">@PlainText(post.Description)</p>
                                <div class="sk-content-card__footer">
                                    <a class="sk-content-card__more" href="/Blog/@post.EndpointPath">
                                        <span>مطالعه مقاله</span>
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                    </a>
                                    <span class="sk-content-card__index">@((i + 1).ToString("00"))</span>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="sk-empty-state"><h2>مقاله‌ای برای نمایش ثبت نشده است</h2></div>
            }
        </div>
    </section>
</div>
