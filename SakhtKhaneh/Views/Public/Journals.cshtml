@model IReadOnlyList<Journal>
@{
    ViewData["Title"] = "ژورنال‌های معماری و نورپردازی";
    ViewData["MetaDescription"] = "ژورنال‌های تصویری ساخت خانه درباره معماری، طراحی داخلی، نورپردازی و جزئیات اجرایی پروژه‌ها.";
    ViewData["VisitType"] = "static";
    ViewData["VisitParam"] = "journals";

    string PlainText(string? html, int maxLength = 170)
    {
        var value = System.Net.WebUtility.HtmlDecode(System.Text.RegularExpressions.Regex.Replace(html ?? string.Empty, "<.*?>", string.Empty));
        value = System.Text.RegularExpressions.Regex.Replace(value, @"\s+", " ").Trim();
        return value.Length <= maxLength ? value : $"{value[..(maxLength - 3)].TrimEnd()}...";
    }
}

@await Html.PartialAsync("_PageHeroPartialView", new PageHeroViewModel
{
    Eyebrow = "ژورنال تصویری",
    Title = "شیت‌های طراحی و",
    AccentTitle = "جزئیات الهام‌بخش",
    Description = "مجموعه‌ای از ایده‌ها، نورپردازی، متریال و جزئیات طراحی که به زبان تصویر روایت می‌شوند.",
    CurrentPageTitle = "ژورنال‌ها"
})

<div class="content-wrapper">
    <section class="content-lines-wrapper" aria-hidden="true"><div class="content-lines-inner"><div class="content-lines"></div></div></section>
    <section class="sk-section section-padding">
        <div class="container">
            <div class="sk-section-heading" data-sk-reveal="up">
                <div class="sk-section-heading__copy">
                    <p class="sk-section-heading__eyebrow">آرشیو ژورنال‌ها</p>
                    <h2 class="sk-section-heading__title">دیدن جزئیاتی که یک فضا را <span>متمایز</span> می‌کنند</h2>
                </div>
            </div>

            @if (Model.Count > 0)
            {
                <div class="sk-card-grid">
                    @for (var i = 0; i < Model.Count; i++)
                    {
                        var item = Model[i];
                        <article class="sk-content-card" data-sk-reveal="up" data-sk-delay-index="@(i % 5)">
                            <a class="sk-content-card__media" href="/Journals/@item.EndpointPath">
                                <img class="sk-content-card__image"
                                     src="@WebAssetUrl.Normalize(item.ImageUrl)"
                                     alt="@(string.IsNullOrWhiteSpace(item.ImageAlt) ? item.Title : item.ImageAlt)"
                                     width="1200"
                                     height="900"
                                     loading="lazy"
                                     decoding="async" />
                            </a>
                            <div class="sk-content-card__body">
                                <p class="sk-content-card__meta">ژورنال معماری</p>
                                <h2 class="sk-content-card__title"><a href="/Journals/@item.EndpointPath">@item.Title</a></h2>
                                <p class="sk-content-card__excerpt">@PlainText(item.Description)</p>
                                <div class="sk-content-card__footer">
                                    <a class="sk-content-card__more" href="/Journals/@item.EndpointPath">
                                        <span>مشاهده ژورنال</span>
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                    </a>
                                    <span class="sk-content-card__index">@((i + 1).ToString("00"))</span>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="sk-empty-state"><h2>ژورنالی برای نمایش ثبت نشده است</h2></div>
            }
        </div>
    </section>
</div>
