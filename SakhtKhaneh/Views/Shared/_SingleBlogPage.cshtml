@using System.Text.Json
@model BlogPost
@inject IConfiguration Configuration
@{
    var siteBaseUrl = (Configuration["Site:BaseUrl"] ?? $"{Context.Request.Scheme}://{Context.Request.Host}").TrimEnd('/');
    var canonicalUrl = $"{siteBaseUrl}/Blog/{Model.EndpointPath}";
    var imageUrl = WebAssetUrl.Normalize(Model.ImageUrl, "/assets/img/banner-1600.webp");
    var absoluteImageUrl = WebAssetUrl.Absolute(imageUrl, siteBaseUrl);
    var seoTitle = string.IsNullOrWhiteSpace(Model.SeoTitle) ? Model.Title : Model.SeoTitle;
    var seoDescription = string.IsNullOrWhiteSpace(Model.MetaDescription) ? Model.Description : Model.MetaDescription;
    seoDescription = seoDescription?.Trim() ?? Model.Title;
    if (seoDescription.Length > 165) seoDescription = $"{seoDescription[..162].TrimEnd()}...";
    var imageAlt = string.IsNullOrWhiteSpace(Model.ImageAlt) ? Model.Title : Model.ImageAlt;
    var contentAuthor = Configuration["Site:ContentAuthor"] ?? "حسین کنعانی";
    var contentAuthorImage = Configuration["Site:ContentAuthorImage"] ?? "/assets/img/author-320.webp";
    var articleContent = Model.Content ?? string.Empty;
    var contentContainsArticle = articleContent.Contains("<article", StringComparison.OrdinalIgnoreCase);
    var contentContainsH1 = articleContent.Contains("<h1", StringComparison.OrdinalIgnoreCase);
    var articleContentWithoutFirstH1 = contentContainsH1
        ? new System.Text.RegularExpressions.Regex("<h1\\b[^>]*>.*?</h1>", System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.Singleline).Replace(articleContent, string.Empty, 1)
        : articleContent;
    var tags = (Model.Tags ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    var publishedUtc = DateTime.SpecifyKind(Model.CreationDate, DateTimeKind.Utc);
    var modifiedUtc = DateTime.SpecifyKind(Model.LastUpdateDate ?? Model.CreationDate, DateTimeKind.Utc);

    ViewData["Title"] = seoTitle;
    ViewData["MetaDescription"] = seoDescription;
    ViewData["CanonicalUrl"] = canonicalUrl;
    ViewData["Author"] = contentAuthor;
    ViewData["OpenGraphType"] = "article";
    ViewData["OpenGraphImage"] = absoluteImageUrl;
    ViewData["VisitType"] = "post";
    ViewData["VisitParam"] = Model.Id.ToString();

    var articleSchema = new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "BlogPosting",
        ["mainEntityOfPage"] = new Dictionary<string, object?> { ["@type"] = "WebPage", ["@id"] = canonicalUrl },
        ["headline"] = Model.Title,
        ["description"] = seoDescription,
        ["image"] = new[] { absoluteImageUrl },
        ["datePublished"] = publishedUtc.ToString("O"),
        ["dateModified"] = modifiedUtc.ToString("O"),
        ["keywords"] = tags,
        ["inLanguage"] = "fa-IR",
        ["author"] = new Dictionary<string, object?>
        {
            ["@type"] = "Person",
            ["name"] = contentAuthor,
            ["image"] = WebAssetUrl.Absolute(contentAuthorImage, siteBaseUrl)
        },
        ["publisher"] = new Dictionary<string, object?>
        {
            ["@type"] = "Organization",
            ["name"] = "ساخت خانه",
            ["logo"] = new Dictionary<string, object?>
            {
                ["@type"] = "ImageObject",
                ["url"] = $"{siteBaseUrl}/assets/img/logo_transparent_bg.png"
            }
        }
    };

    var breadcrumbSchema = new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "BreadcrumbList",
        ["itemListElement"] = new object[]
        {
            new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "صفحه اصلی", ["item"] = siteBaseUrl },
            new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 2, ["name"] = "بلاگ", ["item"] = $"{siteBaseUrl}/Blog" },
            new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 3, ["name"] = Model.Title, ["item"] = canonicalUrl }
        }
    };
}
@section Seo {
    <meta property="article:published_time" content="@publishedUtc.ToString("O")" />
    <meta property="article:modified_time" content="@modifiedUtc.ToString("O")" />
    <meta property="article:author" content="@contentAuthor" />
    @foreach (var tag in tags) { <meta property="article:tag" content="@tag" /> }
    <script type="application/ld+json">@Html.Raw(JsonSerializer.Serialize(articleSchema))</script>
    <script type="application/ld+json">@Html.Raw(JsonSerializer.Serialize(breadcrumbSchema))</script>
}


@await Html.PartialAsync("_PageHeroPartialView", new PageHeroViewModel
{
    Eyebrow = Model.Category?.Title ?? "مقاله تخصصی",
    Title = Model.Title,
    Description = seoDescription,
    CurrentPageTitle = Model.Title,
    ParentTitle = "بلاگ",
    ParentUrl = "/Blog",
    BackgroundImage = imageUrl,
    Compact = true
})

<div class="content-wrapper">
    <section class="content-lines-wrapper" aria-hidden="true"><div class="content-lines-inner"><div class="content-lines"></div></div></section>
    <section class="section-padding2">
        <div class="container">
            <div class="sk-content-shell blog-post">
                <figure class="sk-feature-image" data-sk-reveal="scale">
                    <img src="@imageUrl" alt="@imageAlt" width="1400" height="900" fetchpriority="high" decoding="async" />
                </figure>

                @if (contentContainsArticle)
                {
                    <div data-sk-reveal="up">@Html.Raw(articleContentWithoutFirstH1)</div>
                }
                else
                {
                    <article data-sk-reveal="up">
                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <p class="sk-article-intro">@Model.Description</p>
                        }
                        <div class="article-content">@Html.Raw(articleContentWithoutFirstH1)</div>
                    </article>
                }

                @if (tags.Length > 0)
                {
                    <ul class="journal-tags" aria-label="برچسب‌های مقاله">
                        @foreach (var tag in tags) { <li>#@tag</li> }
                    </ul>
                }

                <div class="sk-author-card" data-sk-reveal="up">
                    <img src="@contentAuthorImage"
                         alt="تصویر نویسنده، @contentAuthor"
                         width="64"
                         height="64"
                         loading="lazy"
                         decoding="async" />
                    <div>
                        <small>نویسنده مقاله</small>
                        <strong>@contentAuthor</strong>
                        <time datetime="@publishedUtc.ToString("yyyy-MM-dd")">انتشار: @IranDateTime.ToPersianDate(Model.CreationDate, true)</time>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
