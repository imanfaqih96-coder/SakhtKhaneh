@model string
@{
    var platform = (Model ?? "custom").Trim().ToLowerInvariant();
}
@if (platform == "instagram")
{
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="17.4" cy="6.7" r="1" fill="currentColor"/></svg>
}
else if (platform == "telegram")
{
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 11 17-7-4 16-5.2-4.2L8 18l.7-5.1L17 7.2 9.9 12 3 11Z" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linejoin="round"/></svg>
}
else if (platform == "whatsapp")
{
